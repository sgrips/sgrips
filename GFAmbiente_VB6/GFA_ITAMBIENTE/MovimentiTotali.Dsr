Attribute VB_Name = "ReportMovTotali"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Public Function Stampa(preview As Boolean, pfrm As frmTotMovimentati, pDal As Date, pAl As Date) As Boolean
    Dim defaultPrinter As String
    Dim s As String
    
    On Error GoTo StampaERR
    
    If DevEnvMDB.rscmdTotaliPerMovimentiBonusPunti.RecordCount = 0 Then Exit Function
    
    defaultPrinter = Printer.DeviceName
    
    SetWinDefPrinter gStampaPesataStampante
    
    'Me.orientation = 0
    
    Stampa = False
    
    Me.RightMargin = pfrm.ScaleX(gStampaPesataMargDx, vbMillimeters, vbTwips)
    Me.LeftMargin = pfrm.ScaleX(gStampaPesataMargSx, vbMillimeters, vbTwips)
    Me.BottomMargin = pfrm.ScaleY(gStampaPesataMargDwn, vbMillimeters, vbTwips)
    Me.TopMargin = pfrm.ScaleY(gStampaPesataMargUp, vbMillimeters, vbTwips)
        
    
    DevEnvMDB.rscmdTotaliPerMovimentiBonusPunti.MoveFirst
    
    Me.Sections("IntestazioneReport").Controls("Label2").Caption = "Calcolati nel periodo dal " & Format$(pDal, "yyyy-MM-dd") & " al " & Format$(pAl, "yyyy-MM-dd")
    
    If preview Then
        Me.Show vbModal
    Else
        Me.PrintReport
        Do While Me.AsyncCount > 0
            DoEvents
        Loop
    End If
    
    SetWinDefPrinter defaultPrinter
    
    Stampa = True
    
    
    Exit Function
StampaERR:

    
    SetWinDefPrinter defaultPrinter
End Function

