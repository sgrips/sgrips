Attribute VB_Name = "DevEnvMDB"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub DataEnvironment_Initialize()
     

    IsolaEcologica.ConnectionString = vbNullString
    
    IsolaEcologica.ConnectionString = "Jet OLEDB:Database Password=" + gPasswordDB + ";Persist Security Info=False;Data Source=" + gPathDB + ";Data Provider=MICROSOFT.JET.OLEDB.4.0"
    IsolaEcologica.CursorLocation = adUseServer
     
End Sub

