Attribute VB_Name = "ReportScontrino"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Dim WithEvents sdfQtaFatt As StdDataFormat
Attribute sdfQtaFatt.VB_VarHelpID = -1
  
Public Sub Stampa(idMovimenti As String, codBadge As String, pfrmPesata As frmPesata, Optional preview As Boolean = False, Optional nrCopie As Integer = 1)
    Dim i As Integer
    Dim defaultPrinter As String
    Dim s As String
    Dim myDev As DEVMODE
    Dim Esci As Boolean
    
    
    On Error GoTo StampaERR
    defaultPrinter = Printer.DeviceName
    
    SetWinDefPrinter gStampaScontrinoStampante
    setDefaultSettingPrint Me.hWnd, defaultPrinter, 0, 2000, 8000, myDev
    
   ' Me.orientation = 0
  
    Me.RightMargin = pfrmPesata.ScaleX(gStampaScontrinoMargDx, vbMillimeters, vbTwips)
    Me.LeftMargin = pfrmPesata.ScaleX(gStampaScontrinoMargSx, vbMillimeters, vbTwips)
    Me.BottomMargin = pfrmPesata.ScaleY(gStampaScontrinoMargDwn, vbMillimeters, vbTwips)
    Me.TopMargin = pfrmPesata.ScaleY(gStampaScontrinoMargUp, vbMillimeters, vbTwips)
    
    If DevEnvMDB.Connections(1).state = adStateOpen Then
        DevEnvMDB.Connections(1).Close
        DevEnvMDB.Connections(1).Open
    End If
    
    If DevEnvMDB.rscmdScontrino_Raggruppam.state = adStateOpen Then
        DevEnvMDB.rscmdScontrino_Raggruppam.Close
    End If
        
        
    DoEvents
        
    s = DevEnvMDB.Commands("cmdScontrino_Raggruppam").CommandText
    DevEnvMDB.Commands("cmdScontrino_Raggruppam").CommandText = Replace(DevEnvMDB.Commands("cmdScontrino_Raggruppam").CommandText, "-999", idMovimenti)
    
    Set sdfQtaFatt = New StdDataFormat


     
        
    Set Me.Sections("cmdScontrino_Detail").Controls("txtQtaFatt").DataFormat = sdfQtaFatt
        
    Me.Sections("cmdScontrino_Raggruppam_Header").Controls("lblDateHour").Caption = Format$(Now, "dd-MMM-yyyy HH\:mm\:ss")
    
    
    Me.Sections("cmdScontrino_Raggruppam_Header").Controls("txtRagioneSociale").Visible = gStampaScontrinoInsRagSocScontrino = 1
    Me.Sections("cmdScontrino_Raggruppam_Header").Controls("txtImpianto").Visible = gStampaScontrinoInsImpiantoScontrino = 1
    Me.Sections("cmdScontrino_Raggruppam_Header").Controls("txtComuneImpianto").Visible = gStampaScontrinoInsComuneImpiantoScontrino = 1
    
    DevEnvMDB.cmdScontrino_Raggruppam codBadge, gIdSocietaProduttore
            
    Dim t As String
    t = Me.Sections("cmdScontrino_Raggruppam_Footer").Controls("lblComuneImmobile").Caption
    If gStampaScontrinoInsDichiaraDiResponsabilita = 1 Then
        t = t & gStampaScontrinoDichiarazione
    End If
    Me.Sections("cmdScontrino_Raggruppam_Footer").Controls("lblComuneImmobile").Caption = Replace(t, "@CODCOMUNE@", DevEnvMDB.rscmdScontrino_Raggruppam!ComuneImmobile)
    
    If (DevEnvMDB.rscmdScontrino_Raggruppam.EOF = False) Then
        If preview Then
            Me.Show vbModal
        Else
            For i = 1 To nrCopie
                Me.PrintReport
                Do While Me.AsyncCount > 0
                    DoEvents
                Loop
            Next
        End If
        Esci = True
    End If
        
        
    DevEnvMDB.Commands("cmdScontrino_Raggruppam").CommandText = s
    
    
    
    SetWinDefPrinter defaultPrinter
    
    Exit Sub
StampaERR:
    
    If s <> vbNullString Then DevEnvMDB.Commands("cmdScontrino_Raggruppam").CommandText = s
    
    SetWinDefPrinter defaultPrinter
    
End Sub


Private Sub sdfQtaFatt_Format(ByVal DataValue As StdFormat.StdDataValue)
    If DataValue.value <> "" Then
        DataValue.value = "FATT " & DataValue.value
    Else
        DataValue.value = ""
    End If
    
End Sub
