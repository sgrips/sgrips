Attribute VB_Name = "ReportPesataConTrasportatore"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Public Sub Stampa(idMovimenti As String, pfrmPesata As frmPesata, Optional preview As Boolean = False, Optional copie As Integer = 1)
    Dim defaultPrinter As String
    Dim s As String
    Dim f As FileSystemObject
    
    Set f = New FileSystemObject
    
    
    On Error GoTo StampaERR
    defaultPrinter = Printer.DeviceName
    
    SetWinDefPrinter gStampaPesataStampante
    
    Me.RightMargin = pfrmPesata.ScaleX(gStampaPesataMargDx, vbMillimeters, vbTwips)
    Me.LeftMargin = pfrmPesata.ScaleX(gStampaPesataMargSx, vbMillimeters, vbTwips)
    Me.BottomMargin = pfrmPesata.ScaleY(gStampaPesataMargDwn, vbMillimeters, vbTwips)
    Me.TopMargin = pfrmPesata.ScaleY(gStampaPesataMargUp, vbMillimeters, vbTwips)
    
    
    Me.orientation = rptOrientPortrait
    
    If DevEnvMDB.Connections(1).state = adStateOpen Then
        DevEnvMDB.Connections(1).Close
        DevEnvMDB.Connections(1).Open
    End If
    
    If DevEnvMDB.rscmdStampaPesata_Raggruppam.state = adStateOpen Then
        DevEnvMDB.rscmdStampaPesata_Raggruppam.Close
    End If
    
    If DevEnvMDB.rscmdSocieta.state = adStateOpen Then
        DevEnvMDB.rscmdSocieta.Close
    End If
        
    DevEnvMDB.cmdSocieta
    DevEnvMDB.rscmdSocieta.Filter = "idSocieta=" & gIdSocietaProduttore

    
        
    Sections("Section2").Controls("Label3").Caption = "Capitale Sociale:" & DevEnvMDB.rscmdSocieta!CapSociale & vbclf & _
                "  Sede Legale:" & DevEnvMDB.rscmdSocieta!Indirizzo & ", " & DevEnvMDB.rscmdSocieta!NumCivico & " " & DevEnvMDB.rscmdSocieta!Cap & " " & DevEnvMDB.rscmdSocieta!Comune & vbclf & _
                "  C.F. e P.IVA:" & DevEnvMDB.rscmdSocieta!CodFiscale & " / " & DevEnvMDB.rscmdSocieta!PartitaIva & _
                "  Reg.Impr:"
        
        
    If DevEnvMDB.rscmdImpianti.state = adStateOpen Then
        DevEnvMDB.rscmdImpianti.Close
    End If
        
    DevEnvMDB.cmdImpianti
    DevEnvMDB.rscmdImpianti.Filter = "idImpianto=" & gIdImpiantoProduttore
    
    Sections("Section7").Controls("lblDichiarazioneData").Caption = DevEnvMDB.rscmdImpianti!Comune & " %D"
        


        
    Sections("Section2").Controls("Label1").Caption = DevEnvMDB.rscmdImpianti!RagioneSociale & vbCrLf & DevEnvMDB.rscmdImpianti!Comune _
                                                      & vbCrLf & DevEnvMDB.rscmdImpianti!Indirizzo & " nr. " & nullToBlank(DevEnvMDB.rscmdImpianti!NumCivico) _
                                                      & vbCrLf & DevEnvMDB.rscmdImpianti!Cap & " Tel. " & nullToBlank(DevEnvMDB.rscmdImpianti!NumeroTelefono) & " Fax. " & nullToBlank(DevEnvMDB.rscmdImpianti!NumeroFax)
    Sections("Section7").Controls("Label15").Caption = "FIRMA ADDETTO" '& DevEnvMDB.rscmdSocieta!RagioneSociale
        
    DoEvents
    
    
    If f.FileExists(App.Path & "\Loghi\" & DevEnvMDB.rscmdSocieta!Logo) Then
        Set x = LoadPicture(App.Path & "\Loghi\" & DevEnvMDB.rscmdSocieta!Logo)
        Set Sections("Section2").Controls("Image2").Picture = x
        Sections("Section2").Controls("Image2").width = (x.width / x.Height) * Sections("Section2").Controls("Image2").Height
        Sections("Section2").Controls("Label3").left = Sections("Section2").Controls("Image2").left + Sections("Section2").Controls("Image2").width
    End If
    
    If f.FileExists(App.Path & "\Loghi\" & DevEnvMDB.rscmdImpianti!Logo) Then
        Set x = LoadPicture(App.Path & "\Loghi\" & DevEnvMDB.rscmdImpianti!Logo)
        Set Sections("Section2").Controls("Image1").Picture = x
        Sections("Section2").Controls("Image1").width = (x.width / x.Height) * Sections("Section2").Controls("Image1").Height
    End If
    
    s = DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText
    idMovimenti = left$(idMovimenti, Len(idMovimenti) - 1)
    DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText = Replace(DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText, "-999", idMovimenti)
    DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText = Replace(DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText, "@RAGSOCIMPIANTO@", Replace(DevEnvMDB.rscmdImpianti!RagioneSociale, "'", "''"))
    
    DevEnvMDB.cmdStampaPesata_Raggruppam
    
    If (DevEnvMDB.rscmdStampaPesata_Raggruppam.EOF = False) Then
    
'        Me.Sections("Section7").Controls("lblDichiaro").Caption = DevEnvMDB.rscmdStampaPesata_Raggruppam("Dichiarazione") + DevEnvMDB.rscmdStampaPesata_Raggruppam("Dichiarazione1")
        Dim t As String
        If gStampaScontrinoInsDichiaraDiResponsabilita = 1 Then
            t = t & gStampaScontrinoDichiarazione
        End If
        Me.Sections("Section7").Controls("lblDichiaro").Caption = Replace(t, "@CODCOMUNE@", DevEnvMDB.rscmdStampaPesata_Raggruppam!ComuneImmobile)
        
        
        If preview Then
            Me.Show vbModal
        Else
            For i = 1 To nrCopie
                Me.PrintReport
                Do While Me.AsyncCount > 0
                    DoEvents
                Loop
            Next
        End If
    End If
        
        
        
        
    DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText = s
    
    
    SetWinDefPrinter defaultPrinter
    
    DevEnvMDB.rscmdSocieta.Filter = ""
    DevEnvMDB.rscmdImpianti.Filter = ""
    
    Exit Sub
StampaERR:
    DevEnvMDB.rscmdSocieta.Filter = ""
    DevEnvMDB.rscmdImpianti.Filter = ""
    
    If s <> vbNullString Then DevEnvMDB.Commands("cmdStampaPesata_Raggruppam").CommandText = s
    SetWinDefPrinter defaultPrinter
End Sub

