Attribute VB_Name = "ReportFormularioSETA"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Public Function Stampa(where As String, preview As Boolean, pfrmFormulari As frmFormulari) As Boolean
    Dim defaultPrinter As String
    Dim s  As String
    
    On Error GoTo StampaERR
    defaultPrinter = Printer.DeviceName
    
    SetWinDefPrinter gStampaRegistroStampante
    
    Me.orientation = rptOrientPortrait
    
    Stampa = False
    
    Me.RightMargin = pfrmFormulari.ScaleX(gStampaFormularioMargDx, vbMillimeters, vbTwips)
    Me.LeftMargin = pfrmFormulari.ScaleX(gStampaFormularioMargSx, vbMillimeters, vbTwips)
    Me.BottomMargin = pfrmFormulari.ScaleY(gStampaFormularioMargDwn, vbMillimeters, vbTwips)
    Me.TopMargin = pfrmFormulari.ScaleY(gStampaFormularioMargUp, vbMillimeters, vbTwips)
        
    
    If DevEnvMDB.rscmdFormulario.state = adStateOpen Then
        DevEnvMDB.rscmdFormulario.Close
    End If
    
    s = DevEnvMDB.rscmdFormulario.Source
    DevEnvMDB.Commands("cmdFormulario").CommandText = Replace(s, "1=1", where)
    DevEnvMDB.cmdFormulario
    
    If (DevEnvMDB.rscmdFormulario.EOF = False) Then
    
        If preview Then
            Me.Show vbModal
        Else
            Me.PrintReport
            Do While Me.AsyncCount > 0
                DoEvents
            Loop
        End If
    End If
    
    SetWinDefPrinter defaultPrinter
    
    Stampa = True
    
    If DevEnvMDB.rscmdFormulario.state = adStateOpen Then
        DevEnvMDB.rscmdFormulario.Close
        DevEnvMDB.rscmdFormulario.Source = s
    End If
    
    
    Exit Function
StampaERR:
    If DevEnvMDB.rscmdFormulario.state = adStateOpen Then
        DevEnvMDB.rscmdFormulario.Close
        DevEnvMDB.rscmdFormulario.Source = s
    End If
    
    SetWinDefPrinter defaultPrinter
End Function

