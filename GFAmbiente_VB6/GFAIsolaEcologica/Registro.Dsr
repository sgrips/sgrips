Attribute VB_Name = "ReportRegistro"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Public Function Stampa(where As String, preview As Boolean, pfrmUscita As frmRegistri) As Boolean
    Dim defaultPrinter As String
    Dim s As String
    
    On Error GoTo StampaERR
    defaultPrinter = Printer.DeviceName
    
    SetWinDefPrinter gStampaRegistroStampante
    
    Me.orientation = rptOrientPortrait
    
    Stampa = False
    
    Me.RightMargin = pfrmUscita.ScaleX(gStampaRegistroMargDx, vbMillimeters, vbTwips)
    Me.LeftMargin = pfrmUscita.ScaleX(gStampaRegistroMargSx, vbMillimeters, vbTwips)
    Me.BottomMargin = pfrmUscita.ScaleY(gStampaRegistroMargDwn, vbMillimeters, vbTwips)
    Me.TopMargin = pfrmUscita.ScaleY(gStampaRegistroMargUp, vbMillimeters, vbTwips)
        
    
    If DevEnvMDB.rscmdRegistro.state = adStateOpen Then
        DevEnvMDB.rscmdRegistro.Close
    End If
    
    
    s = DevEnvMDB.rscmdRegistro.Source
    DevEnvMDB.Commands("cmdRegistro").CommandText = Replace(s, "1=1", where)
    DevEnvMDB.cmdRegistro
    
    
    If (DevEnvMDB.rscmdRegistro.EOF = False) Then
    
        If preview Then
            Me.Show vbModal
        Else
            Me.PrintReport
            Do While Me.AsyncCount > 0
                DoEvents
            Loop
        End If
    End If
    
    SetWinDefPrinter defaultPrinter
    
    Stampa = True
    
    If DevEnvMDB.rscmdRegistro.state = adStateOpen Then
        DevEnvMDB.rscmdRegistro.Close
        DevEnvMDB.rscmdRegistro.Source = s
    End If
    
    Exit Function
StampaERR:
    If DevEnvMDB.rscmdRegistro.state = adStateOpen Then
        DevEnvMDB.rscmdRegistro.Close
        DevEnvMDB.rscmdRegistro.Source = s
    End If
    
    SetWinDefPrinter defaultPrinter
End Function

