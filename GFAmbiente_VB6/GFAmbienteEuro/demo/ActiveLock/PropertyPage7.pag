Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).RegRandomKey = txtRegRandomKey.Text
    SelectedControls(0).RegInitialRunDateKey = txtRegInitialRunDateKey.Text
    SelectedControls(0).RegLastRunDateKey = txtRegLastRunDateKey.Text
    SelectedControls(0).RegLiberationKey = txtRegLiberationKey.Text
    SelectedControls(0).RegCounterKey = txtRegCounterKey.Text
End Sub


Private Sub PropertyPage_SelectionChanged()
    txtRegRandomKey.Text = SelectedControls(0).RegRandomKey
    txtRegInitialRunDateKey.Text = SelectedControls(0).RegInitialRunDateKey
    txtRegLastRunDateKey.Text = SelectedControls(0).RegLastRunDateKey
    txtRegLiberationKey.Text = SelectedControls(0).RegLiberationKey
    txtRegCounterKey.Text = SelectedControls(0).RegCounterKey
End Sub


