Attribute VB_Name = "PropertyPage2"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Option Explicit

' Author: Nelson Ferraz
' Date  : 1998-2002
'
' Update: Nick Hall (included RegistryKey/Path/Hive)
' Date  : Jul/2002

Private Sub txtRegistryHive_Change()
    Changed = True
    If txtRegistryHive.Text = "HKCU" Then
        optRegistryHive(0).Value = True
        optRegistryHive(1).Value = False
    ElseIf txtRegistryHive.Text = "HKLM" Then
        optRegistryHive(0).Value = False
        optRegistryHive(1).Value = True
    End If
    
End Sub

Private Sub txtRegistryName_Change()
    Changed = True
End Sub

Private Sub txtRegistryPath_Change()
    Changed = True
End Sub

Private Sub txtRegistryKey_Change()
    Changed = True
End Sub

Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).RegistryPath = txtRegistryPath.Text
    SelectedControls(0).RegistryKey = txtRegistryKey.Text
    SelectedControls(0).RegistryHive = txtRegistryHive.Text
    SelectedControls(0).RegistryName = txtRegistryName.Text
    
End Sub

Private Sub PropertyPage_SelectionChanged()
    txtRegistryPath.Text = SelectedControls(0).RegistryPath
    txtRegistryKey.Text = SelectedControls(0).RegistryKey
    txtRegistryHive.Text = SelectedControls(0).RegistryHive
    txtRegistryName.Text = SelectedControls(0).RegistryName
End Sub

Private Sub optRegistryHive_Click(Index As Integer)
 If optRegistryHive(0).Value = True Then
  txtRegistryHive.Text = "HKCU"
 Else
  txtRegistryHive.Text = "HKLM"
 End If
End Sub

