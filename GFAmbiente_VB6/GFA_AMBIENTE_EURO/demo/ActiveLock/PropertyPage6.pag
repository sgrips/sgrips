Attribute VB_Name = "PropertyPage6"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Private Sub chkUseDataLock_Click()
    Changed = True
End Sub

Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).UseDataLock = (chkUseDataLock.Value = vbChecked)
End Sub


Private Sub PropertyPage_SelectionChanged()
    chkUseDataLock.Value = (SelectedControls(0).UseDataLock And vbChecked)
End Sub


