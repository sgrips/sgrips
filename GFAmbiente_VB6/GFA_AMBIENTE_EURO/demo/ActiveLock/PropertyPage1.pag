Option Explicit

' Author: Nelson Ferraz
' Date  : 1998-2002

Private Sub txtSoftwareName_Change()
    Changed = True
End Sub


Private Sub PropertyPage_ApplyChanges()
    SelectedControls(0).SoftwareName = txtSoftwareName.Text
    SelectedControls(0).SoftwarePassword = txtsoftwarepassword.Text
End Sub


Private Sub PropertyPage_SelectionChanged()
    txtSoftwareName.Text = SelectedControls(0).SoftwareName
    txtsoftwarepassword.Text = SelectedControls(0).SoftwarePassword
    
End Sub


Private Sub txtSoftwarepassword_Change()
    Changed = True
End Sub

