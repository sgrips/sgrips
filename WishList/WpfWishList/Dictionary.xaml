<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:em="clr-namespace:Sgrips.WishList.WPF"
                    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" >


    <Style x:Key="myErrorTemplate" TargetType="{x:Type Control}">
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <ControlTemplate.Resources>
                        <BooleanToVisibilityConverter x:Key="converter"/>
                    </ControlTemplate.Resources>
                    <Grid Visibility="{Binding ElementName=adorner, Mode=OneWay, Path=AdornedElement.IsVisible, Converter={StaticResource converter}}">
                        <Border BorderBrush="#FFDB000C" BorderThickness="2" CornerRadius="1" IsHitTestVisible="False">
                            <Grid Height="12" HorizontalAlignment="Right" Margin="1,-4,-4,0" VerticalAlignment="Top" Width="12" Background="Transparent">
                                <Path Fill="#FFDC000C" Margin="1,3,0,0" Data="M 1,0 L6,0 A 2,2 90 0 1 8,2 L8,7 z" />
                                <Path Fill="#ffffff" Margin="1,3,0,0" Data="M 0,0 L2,0 L 8,6 L8,8" />
                            </Grid>
                        </Border>
                        <AdornedElementPlaceholder x:Name="adorner"/>
                    </Grid>
                </ControlTemplate>


            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
                        Value="{Binding  Path=(Validation.Errors), Converter={em:ConverterStringError}, RelativeSource={x:Static RelativeSource.Self}}"/>

                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#19FF0000" Offset="0"/>
                            <GradientStop Color="#19FB6657" Offset="1"/>
                            <GradientStop Color="#19F32323" Offset="0.397"/>
                            <GradientStop Color="#19EC3030" Offset="0.774"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource myErrorTemplate}" />
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource myErrorTemplate}" />
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource myErrorTemplate}" />
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource myErrorTemplate}" />
</ResourceDictionary>    
    
    